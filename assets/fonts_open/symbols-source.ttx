           be able to retain the original information, we need a name to
           ps name mapping for those cases where they differ. That's what
           you see below.
            -->
    </psNames>
    <extraNames>
      <!-- following are the name that are not taken from the standard Mac glyph order -->
      <psName name="uni0000"/>
      <psName name="uni000D"/>
      <psName name="uniE0A0"/>
      <psName name="uniE0A1"/>
