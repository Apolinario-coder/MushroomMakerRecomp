      <psName name="uniE0E8"/>
      <psName name="uniE0E9"/>
      <psName name="uniE0EF"/>
      <psName name="uniE0F0"/>
    </extraNames>
  </post>

  <gasp>
    <gaspRange rangeMaxPPEM="65535" rangeGaspBehavior="15"/>
  </gasp>

</ttFont>
