<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MushroomMakerRecomp" Width="1136" Height="780" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" FontFamily="Segoe UI"
        Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#FFF9EA"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFEF8"/>
    <SolidColorBrush x:Key="Ink" Color="#302B23"/>
    <SolidColorBrush x:Key="Muted" Color="#655D50"/>
    <SolidColorBrush x:Key="BuilderYellow" Color="#FBCB25"/>
    <SolidColorBrush x:Key="Edge" Color="#A69C86"/>
    <SolidColorBrush x:Key="Hover" Color="#FFE599"/>
    <SolidColorBrush x:Key="Pressed" Color="#E7B30B"/>
    <SolidColorBrush x:Key="Disabled" Color="#E5DFD0"/>
    <SolidColorBrush x:Key="Error" Color="#9E2823"/>
    <Thickness x:Key="PageSpace">32</Thickness>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="15"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="20,12"/><Setter Property="MinHeight" Value="48"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Pressed}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="4"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Background" Value="{StaticResource Disabled}"/><Setter Property="Cursor" Value="Arrow"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12"/><Setter Property="MinHeight" Value="48"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/><Setter Property="BorderThickness" Value="2"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Disabled}"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource Surface}">
    <Viewbox x:Name="FitLayout" Stretch="Uniform" StretchDirection="DownOnly">
      <Grid x:Name="DesignSurface" Width="1120" Height="740" Background="{StaticResource Surface}">
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="152"/></Grid.RowDefinitions>
        <Border x:Name="HeaderPanel" Background="{StaticResource BuilderYellow}" Padding="32,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="MUSHROOM MAKER RECOMP" FontWeight="Black" FontSize="22"/><TextBlock Text="Unofficial PC port" FontSize="12" Margin="0,2,0,0"/></StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Ink}" CornerRadius="6" Padding="14,10" VerticalAlignment="Center"><TextBlock Text="UPDATE 3.0.3" Foreground="{StaticResource Surface}" FontWeight="Bold" FontSize="12"/></Border>
          </Grid>
        </Border>
        <StackPanel x:Name="HeroPanel" Grid.Row="1" Margin="32,12,32,8">
          <TextBlock Text="LET'S GET BUILDING." FontWeight="Black" FontSize="36"/>
          <TextBlock Text="Choose your game files. We will prepare them for your PC." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="32,0,32,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="FormPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="22,18">
            <StackPanel>
              <TextBlock Text="Your files" FontWeight="Bold" FontSize="23" Margin="0,0,0,16"/>
              <Label Target="{Binding ElementName=Dump}" Content="Game folder (version 3.0.3)" FontWeight="Bold" Padding="0" Margin="0,0,0,7"/>
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="Dump" AutomationProperties.Name="Game folder"/><Button x:Name="BrowseDump" Grid.Column="1" Content="Browse" Margin="10,0,0,0" AutomationProperties.Name="Browse for game folder"/>
              </Grid>
              <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="Everything is included" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="You do not need to install any extra programs." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Choose the folder containing your complete game files. We will look through its subfolders automatically and leave your files in place."
                         FontSize="13" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
          <Grid x:Name="HelpPanel" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="148"/></Grid.RowDefinitions>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="20,16">
              <StackPanel>
                <TextBlock Text="Before you start" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>
                <TextBlock Text="Use your own complete game files with version 3.0.3 included. Update files on their own are not enough." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                <TextBlock Text="The first preparation may take a few minutes. Keep this window open. After that, choose Play to start your game." FontSize="13" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="16,12">
              <Expander x:Name="LogPanel" Header="Activity" IsExpanded="True">
                <StackPanel><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Height="52"
                         Text="Preparation progress will appear here." FontFamily="Consolas" FontSize="11" MinHeight="0" Padding="6" Margin="0,8,0,0" AutomationProperties.Name="Preparation activity"/>
                  <Button x:Name="OpenReport" Content="Open saved report" FontSize="11" MinHeight="26" Padding="8,3" Margin="0,5,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </Expander>
            </Border>
          </Grid>
        </Grid>
        <Grid x:Name="FooterPanel" Grid.Row="3" Margin="32,0,32,16">
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="StatusBox" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="14,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="StatusMarker" Width="8" Height="8" CornerRadius="4" Background="{StaticResource BuilderYellow}" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border>
              <TextBlock x:Name="Status" Grid.Column="1" Text="Choose your game folder, then check the files." VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
          </Border>
          <Grid x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,3,0,3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText" FontSize="11" Text="Waiting to start..." Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="ProgressPercent" Grid.Column="1" FontSize="11" FontWeight="Bold" Text=""/>
            <ProgressBar x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,3,0,0" Maximum="100" ToolTip="Progress for the current step. Each step has its own item count." IsIndeterminate="False" Foreground="{StaticResource BuilderYellow}" Background="{StaticResource Ink}" BorderThickness="0" AutomationProperties.Name="Current preparation step progress"/>
          </Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="Check" Content="Check files" Margin="0,0,10,0"/>
              <Button x:Name="Prepare" Content="Prepare game" Margin="0,0,10,0"/>
              <Button x:Name="Play" Content="Play" Background="{StaticResource BuilderYellow}" MinWidth="140"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Esc or Select / Back / Minus opens PC settings." FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="Independent fan project. Game files are supplied by you." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
